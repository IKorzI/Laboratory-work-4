{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safety&Culture Hub Database",
  "description": "Тестова модифікація для перевірки помилки.",
  "type": "object",
  "properties": {
    "region": {
      "type": "object",
      "description": "Регіон проживання працівника",
      "properties": {
        "regionId": {
          "type": "integer",         // 🧨 помилка: нижче $ref вимагає string
          "description": "Унікальний ідентифікатор регіону"
        },
        "name": {
          "type": "string",
          "description": "Назва регіону",
          "pattern": "^[0-9]+$"
        }
      },
      "required": ["regionId", "name"]
    },

    "worker": {
      "type": "object",
      "description": "Працівник підприємства",
      "properties": {
        "workerId": {
          "type": "string"
        },
        "surname": {
          "type": "string"
        },
        "region": {
          "$ref": "#/definitions/region"   // 🧨 помилка: розділу "definitions" не існує
        }
      },
      "required": ["workerId", "surname", "region"]
    }
  },

  // 🧨 ще одна помилка: неправильний ключ замість "required"
  "requiered": ["region", "worker"]
}
